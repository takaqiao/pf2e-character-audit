<div class="party-audit-app">
  <aside class="audit-member-list">
    <h3>{{labels.memberSection}}</h3>
    <ul>
      {{#each members}}
        <li>
          <div class="audit-member {{#if (eq this.id ../selectedId)}}active{{/if}}" role="button" tabindex="0" data-action="selectMember" data-actor-id="{{this.id}}">
            <div class="member-row member-row-name">{{this.name}}</div>
            <div class="member-row member-row-meta">
              <span class="member-level">Lv {{this.level}}</span>
              <span class="member-badges">
                {{#if this.summary.completeness.errors}}<span class="audit-badge error">E {{this.summary.completeness.errors}}</span>{{/if}}
                {{#if this.summary.prerequisites.fail}}<span class="audit-badge error">F {{this.summary.prerequisites.fail}}</span>{{/if}}
                {{#if this.summary.completeness.warnings}}<span class="audit-badge warn">W {{this.summary.completeness.warnings}}</span>{{/if}}
                {{#if this.summary.prerequisites.unknown}}<span class="audit-badge info">? {{this.summary.prerequisites.unknown}}</span>{{/if}}
              </span>
            </div>
          </div>
        </li>
      {{/each}}
      <li>
        <div class="audit-member cross {{#if (eq selectedId "__cross__")}}active{{/if}}" role="button" tabindex="0" data-action="selectMember" data-actor-id="__cross__">
          <div class="member-row member-row-name">📊 {{labels.crossLabel}}</div>
        </div>
      </li>
    </ul>
  </aside>

  <main class="party-audit-main">
    {{#if (eq selectedId "__cross__")}}
      <h2>{{labels.crossLabel}}</h2>
      <table class="audit-table">
        <thead>
          <tr>
            <th>{{localize "PF2E-CA.Field.Title"}}</th>
            <th>{{localize "PF2E-CA.Field.License"}}</th>
            <th class="num">{{localize "PF2E-CA.Field.Count"}}</th>
            <th>{{localize "PF2E-CA.Field.Actors"}}</th>
          </tr>
        </thead>
        <tbody>
        {{#each crossPartyPublication.byTitle}}
          <tr class="{{#if this.isUnknown}}unknown{{/if}}">
            <td>{{#if this.isUnknown}}⚠️ {{/if}}{{this.title}}</td>
            <td>{{this.licenseDisplay}}</td>
            <td class="num">{{this.count}}</td>
            <td>
              {{#each this.actorBreakdown}}
                <span class="actor-tag">{{this.actor}}: {{this.count}}</span>
              {{/each}}
            </td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    {{else if selected}}
      <header class="audit-header">
        <h2>{{selected.actorName}} <span class="audit-level">Lv {{selected.actorLevel}}</span></h2>
      </header>

      <nav class="audit-tabs">
        {{#each tabs}}
          <button type="button" class="audit-tab {{#if (eq this.id ../activeTab)}}active{{/if}}" data-action="switchTab" data-tab="{{this.id}}">{{this.label}}</button>
        {{/each}}
      </nav>

      <section class="audit-tab-content">
        {{#if (eq activeTab "overview")}}
          {{> "modules/pf2e-character-audit/templates/partials/overview-card.hbs" report=selected variants=selected.variants summary=selected.summary labels=labels}}
        {{/if}}
        {{#if (eq activeTab "publication")}}
          {{> "modules/pf2e-character-audit/templates/partials/publication-table.hbs" publication=selected.publication labels=labels}}
        {{/if}}
        {{#if (eq activeTab "completeness")}}
          {{> "modules/pf2e-character-audit/templates/partials/completeness-list.hbs" completeness=selected.completeness labels=labels}}
        {{/if}}
        {{#if (eq activeTab "prereq")}}
          {{> "modules/pf2e-character-audit/templates/partials/prereq-list.hbs" prerequisites=selected.prerequisites labels=labels}}
        {{/if}}
      </section>
    {{else}}
      <p class="audit-empty">{{localize "PF2E-CA.Label.NoPartyMembers"}}</p>
    {{/if}}
  </main>

  <footer class="audit-footer">
    <button type="button" data-action="rerun"><i class="fas fa-redo"></i> {{labels.rerun}}</button>
    <button type="button" data-action="exportChat"><i class="fas fa-comment"></i> {{labels.chat}}</button>
    <button type="button" data-action="exportJournal"><i class="fas fa-book"></i> {{labels.journal}}</button>
    <button type="button" data-action="exportJson"><i class="fas fa-code"></i> {{labels.json}}</button>
  </footer>
</div>
