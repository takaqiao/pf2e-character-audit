<div class="audit-prereq">
  {{#if prerequisites}}
    <div class="audit-summary-counts inline">
      <span class="pass"><i class="fa-solid fa-check"></i>{{prerequisites.summary.pass}} {{labels.passLabel}}</span>
      <span class="error"><i class="fa-solid fa-circle-xmark"></i>{{prerequisites.summary.fail}} {{labels.failLabel}}</span>
      <span class="info"><i class="fa-solid fa-circle-question"></i>{{prerequisites.summary.unknown}} {{labels.unknownLabel}}</span>
    </div>
    {{#if (eq prerequisites.issues.length 0)}}
      <p class="audit-empty ok"><i class="fa-solid fa-circle-check"></i> {{labels.noIssues}}</p>
    {{else}}
      <ul class="audit-issue-list">
      {{#each prerequisites.issues}}
        <li class="audit-issue {{this.severity}}">
          <span class="audit-issue-icon">
            {{#if (eq this.evaluation "fail")}}<i class="fa-solid fa-circle-xmark"></i>{{else}}<i class="fa-solid fa-circle-question"></i>{{/if}}
          </span>
          <div class="audit-issue-body">
            <div class="audit-issue-title">
              <a data-action="openItem" data-uuid="Actor.{{../report.actorId}}.Item.{{this.featId}}">{{this.featName}}</a>
              <small>Lv {{this.featLevel}} &middot; {{this.featSource}}</small>
            </div>
            <div class="audit-issue-hint"><b>{{localize "PF2E-CA.Field.Requirement"}}:</b> {{this.requirement}}</div>
            {{#if this.normalizedRequirement}}{{#unless (eq this.normalizedRequirement this.requirement)}}
              <span class="audit-prereq-normalized">&rarr; {{this.normalizedRequirement}}</span>
            {{/unless}}{{/if}}
            {{#if this.reasons.length}}
              <ul class="audit-reasons">
                {{#each this.reasons}}
                  <li>&middot; {{this}}</li>
                {{/each}}
              </ul>
            {{/if}}
          </div>
        </li>
      {{/each}}
      </ul>
    {{/if}}
  {{else}}
    <p class="audit-empty">{{localize "PF2E-CA.Label.PrereqDisabled"}}</p>
  {{/if}}
</div>
