<div class="audit-completeness">
  {{#if completeness}}
    {{#if (eq completeness.summary.total 0)}}
      <p class="audit-empty ok"><i class="fa-solid fa-circle-check"></i> {{labels.noIssues}}</p>
    {{else}}
      <div class="audit-summary-counts inline">
        <span class="error"><i class="fa-solid fa-circle-exclamation"></i>{{completeness.summary.errors}} {{localize "PF2E-CA.Label.Errors"}}</span>
        <span class="warn"><i class="fa-solid fa-triangle-exclamation"></i>{{completeness.summary.warnings}} {{localize "PF2E-CA.Label.Warnings"}}</span>
        <span class="info"><i class="fa-solid fa-circle-info"></i>{{completeness.summary.infos}} {{localize "PF2E-CA.Label.Infos"}}</span>
      </div>
      <ul class="audit-issue-list">
      {{#each completeness.issues}}
        <li class="audit-issue {{this.severity}}">
          <span class="audit-issue-icon">{{{this.icon}}}</span>
          <div class="audit-issue-body">
            <div class="audit-issue-title">{{this.titleText}}</div>
            <div class="audit-issue-hint">{{this.hintText}}</div>
            <code class="audit-issue-code">{{this.code}}</code>
          </div>
        </li>
      {{/each}}
      </ul>
    {{/if}}
  {{else}}
    <p class="audit-empty">{{localize "PF2E-CA.Label.CompletenessDisabled"}}</p>
  {{/if}}
</div>
