<div class="audit-completeness">
  {{#if completeness}}
    <div class="audit-filter-bar">
      <span class="filter-label">{{labels.filterShow}}:</span>
      <button type="button" class="audit-filter-chip {{#if (eq severityFilter "all")}}active{{/if}}" data-action="filterSev" data-sev="all">{{labels.filterAll}}</button>
      <button type="button" class="audit-filter-chip {{#if (eq severityFilter "error")}}active{{/if}}" data-action="filterSev" data-sev="error">{{labels.filterError}}</button>
      <button type="button" class="audit-filter-chip {{#if (eq severityFilter "warn")}}active{{/if}}" data-action="filterSev" data-sev="warn">{{labels.filterWarn}}</button>
      <button type="button" class="audit-filter-chip {{#if (eq severityFilter "info")}}active{{/if}}" data-action="filterSev" data-sev="info">{{labels.filterInfo}}</button>
      {{#if suppressedCount}}
        <span class="audit-filter-spacer"></span>
        <button type="button" class="audit-filter-chip" data-action="unsuppressAll" title="{{labels.unsuppressLabel}}"><i class="fa-solid fa-eye"></i> {{labels.unsuppressLabel}} ({{suppressedCount}})</button>
      {{/if}}
    </div>

    {{#if (eq completeness.issues.length 0)}}
      {{#if completeness.allIssueCount}}
        <p class="audit-empty">{{labels.noIssues}}</p>
      {{else}}
        <p class="audit-empty ok"><i class="fa-solid fa-circle-check"></i> {{labels.noIssues}}</p>
      {{/if}}
    {{else}}
      <ul class="audit-issue-list">
      {{#each completeness.issues}}
        <li class="audit-issue {{this.severity}}">
          <span class="audit-issue-icon">{{{this.icon}}}</span>
          <div class="audit-issue-body">
            <div class="audit-issue-title">{{this.titleText}}</div>
            <div class="audit-issue-hint">{{this.hintText}}</div>
            <div class="audit-issue-footer">
              <code class="audit-issue-code">{{this.code}}</code>
              <button type="button" class="audit-issue-suppress" data-action="suppressIssue" data-code="{{this.code}}" title="{{../labels.suppressLabel}}"><i class="fa-solid fa-eye-slash"></i></button>
            </div>
          </div>
        </li>
      {{/each}}
      </ul>
    {{/if}}
  {{else}}
    <p class="audit-empty">{{localize "PF2E-CA.Label.CompletenessDisabled"}}</p>
  {{/if}}
</div>
